# Binance — use chaves da TESTNET enquanto USE_TESTNET=true
BINANCE_API_KEY=sua_api_key_aqui
BINANCE_SECRET_KEY=seu_secret_key_aqui

# Ambiente
USE_TESTNET=true
DRY_RUN=true
ALLOW_LIVE_TRADING=false

# Logging
RUST_LOG=info

# Opcional: substitui config/default.toml
BINANCE_CONFIG_PATH=/config/default.toml
